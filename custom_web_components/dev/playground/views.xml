<odoo>
    <record id="view_playground_order_list" model="ir.ui.view">
        <field name="name">web.component.playground.order.list</field>
        <field name="model">web.component.playground.order</field>
        <field name="arch" type="xml">
            <list string="List View Playground" editable="bottom" limit="15">
                <field name="name" width="160px"/>
                <field name="partner_id" width="220px"/>
                <field name="order_date" width="140px"/>
                <field name="salesperson_id" width="180px" optional="show"/>
                <field name="state" width="120px"/>
                <field name="amount" width="150px" sum="金额合计"/>
                <field name="note" width="360px" optional="show"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="create_date" optional="hide" width="200px"/>
            </list>
        </field>
    </record>
    <record id="view_playground_order_form" model="ir.ui.view">
        <field name="name">web.component.playground.order.form</field>
        <field name="model">web.component.playground.order</field>
        <field name="arch" type="xml">
            <form string="Playground 演示订单"><sheet><group>
                <field name="name"/><field name="partner_id"/><field name="order_date"/>
                <field name="salesperson_id"/><field name="state"/><field name="amount"/>
                <field name="currency_id" invisible="True"/><field name="note"/>
            </group></sheet></form>
        </field>
    </record>
    <record id="action_playground_list" model="ir.actions.act_window">
        <field name="name">List View Playground</field>
        <field name="res_model">web.component.playground.order</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_playground_order_list"/>
    </record>
    <record id="action_open_playground" model="ir.actions.server">
        <field name="name">List View Playground</field>
        <field name="model_id" ref="model_web_component_playground_order"/>
        <field name="state">code</field>
        <field name="code">action = model.open_playground()</field>
        <field name="group_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="action_theme_palette" model="ir.actions.client">
        <field name="name">主题</field>
        <field name="tag">custom_web_components.theme_palette</field>
    </record>
    <record id="action_component_catalog" model="ir.actions.client">
        <field name="name">组件</field>
        <field name="tag">custom_web_components.component_catalog</field>
    </record>
    <menuitem id="menu_developer_tools" name="开发工具" groups="base.group_user" sequence="990"/>
    <menuitem id="menu_component_catalog" name="组件" parent="menu_developer_tools" action="action_component_catalog" sequence="10"/>
    <menuitem id="menu_component_playground" name="Component Playground" parent="menu_developer_tools" sequence="20"/>
    <menuitem id="menu_playground_list" name="List View" parent="menu_component_playground" action="action_open_playground" sequence="10"/>
    <menuitem id="menu_theme_palette" name="主题" parent="menu_developer_tools" action="action_theme_palette" sequence="30"/>
</odoo>
