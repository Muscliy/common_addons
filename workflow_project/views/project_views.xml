<odoo>
    <record id="project_task_form_workflow" model="ir.ui.view">
        <field name="name">project.task.form.workflow</field><field name="model">project.task</field><field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml"><xpath expr="//div[@name='button_box']" position="inside">
            <field name="workflow_can_open" invisible="1"/>
            <button type="object" name="action_workflow_monitor" class="oe_stat_button" icon="fa-sitemap" invisible="not workflow_can_open">
                <field name="workflow_status" widget="statinfo" string="工作流"/>
            </button>
        </xpath></field>
    </record>
    <record id="link_list" model="ir.ui.view">
        <field name="name">workflow.project.link.list</field><field name="model">workflow.project.link</field>
        <field name="arch" type="xml"><list create="0" delete="0">
            <field name="name"/><field name="instance_id"/><field name="project_task_id"/><field name="assignee_ids" widget="many2many_tags"/><field name="state" widget="badge"/>
            <button name="action_monitor" type="object" string="打开流程"/><button name="action_open" type="object" string="项目任务"/>
        </list></field>
    </record>
    <record id="my_project_tasks" model="ir.actions.act_window">
        <field name="name">项目待办</field><field name="res_model">workflow.project.link</field><field name="view_mode">list</field>
        <field name="domain">[('state', '=', 'pending'), ('assignee_ids', 'in', [uid])]</field>
    </record>
    <menuitem id="menu_project_tasks" name="项目待办" parent="workflow_core.menu_root" action="my_project_tasks" sequence="22" groups="workflow_core.group_executor"/>
</odoo>
