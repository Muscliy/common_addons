<odoo>
    <record id="approval_list" model="ir.ui.view">
        <field name="name">workflow.approval.list</field><field name="model">workflow.approval</field>
        <field name="arch" type="xml"><list create="0" delete="0" action="action_monitor" type="object">
            <field name="name" string="审批名称"/><field name="instance_id" string="流程实例"/><field name="requested_by" string="申请人"/><field name="state" string="状态" widget="badge"/>
            <field name="create_date" string="申请时间"/><button name="action_monitor" type="object" string="打开流程审批"/>
        </list></field>
    </record>
    <record id="approval_form" model="ir.ui.view">
        <field name="name">workflow.approval.form</field><field name="model">workflow.approval</field>
        <field name="arch" type="xml"><form create="0" edit="0" delete="0">
            <header><button name="action_monitor" type="object" string="打开流程审批" class="btn-primary"/><field name="state" string="状态" widget="statusbar"/></header>
            <sheet><group><field name="name" string="审批名称"/><field name="instance_id" string="流程实例"/><field name="requested_by" string="申请人"/><field name="finished_at" string="结束时间"/></group>
                <field name="review_ids" readonly="1"><list create="0" delete="0"><field name="sequence" string="审批级次"/><field name="reviewer_ids" string="审批人" widget="many2many_tags"/><field name="status" string="审批状态"/><field name="done_by" string="实际审批人"/><field name="comment" string="审批意见"/></list></field>
            </sheet>
        </form></field>
    </record>
    <record id="my_approvals" model="ir.actions.act_window">
        <field name="name">我的审批</field><field name="res_model">workflow.approval</field><field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'pending'), ('review_ids', 'any', [('reviewer_ids', 'in', [uid]), ('status', '=', 'pending')])]</field>
    </record>
    <menuitem id="menu_approvals" name="我的审批" parent="workflow_core.menu_root" action="my_approvals" sequence="25" groups="workflow_tier_validation.group_approver"/>
</odoo>
