<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_resource_calendar_form_cn" model="ir.ui.view">
        <field name="name">resource.calendar.form.cn</field>
        <field name="model">resource.calendar</field>
        <field name="inherit_id" ref="resource.resource_calendar_form"/>
        <field name="arch" type="xml">
            <xpath expr="//label[@for='full_time_required_hours'][2]" position="attributes">
                <attribute name="string">每周工时</attribute>
            </xpath>
            <xpath expr="//field[@name='full_time_required_hours']/following-sibling::span" position="replace">
                <span> 小时/周</span>
            </xpath>
        </field>
    </record>
</odoo>
