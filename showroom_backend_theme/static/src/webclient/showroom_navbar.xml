<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t
        t-name="showroom_backend_theme.NavBar"
        t-inherit="web.NavBar"
        t-inherit-mode="extension"
    >
        <xpath expr="//t[@t-call='web.NavBar.AppsMenu']" position="replace">
            <t t-if="this.ui.isSmall">
                <t t-call="web.NavBar.AppsMenu">
                    <t t-set="apps" t-value="menuService.getApps()"/>
                </t>
            </t>
            <t t-else="">
                <div class="o_showroom_brand" t-att-title="showroomCompanyName">
                    <span class="o_showroom_brand_logo">
                        <img t-att-src="showroomCompanyLogoUrl" alt="企业标志"/>
                    </span>
                    <span class="o_showroom_brand_copy">
                        <strong t-esc="showroomCompanyName"/>
                        <small>智能制造管理平台</small>
                    </span>
                </div>
            </t>
        </xpath>

        <xpath expr="//div[hasclass('o_menu_systray')]" position="after">
            <div
                t-if="showroomSettingsApp or showroomAppsApp"
                class="o_showroom_settings_menu"
            >
                <Dropdown>
                    <button
                        type="button"
                        class="o_showroom_settings_button btn btn-link"
                        title="管理"
                        aria-label="管理"
                    >
                        <i class="fa fa-cog" aria-hidden="true"/>
                    </button>
                    <t t-set-slot="content">
                        <DropdownItem
                            t-if="showroomSettingsApp"
                            class="'o_showroom_management_item'"
                            onSelected="() => this.openShowroomSettings()"
                        >
                            <i class="fa fa-sliders me-2" aria-hidden="true"/>
                            系统设置
                        </DropdownItem>
                        <DropdownItem
                            t-if="showroomAppsApp"
                            class="'o_showroom_management_item'"
                            onSelected="() => this.openShowroomApps()"
                        >
                            <i class="fa fa-th-large me-2" aria-hidden="true"/>
                            应用管理
                        </DropdownItem>
                    </t>
                </Dropdown>
            </div>
        </xpath>
    </t>
</templates>
