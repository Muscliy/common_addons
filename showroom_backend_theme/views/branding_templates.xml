<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="showroom_layout_branding" inherit_id="web.layout" name="TYJ Layout Branding">
        <xpath expr="//title" position="replace">
            <title t-esc="title or 'TYJ 企业管理'"/>
        </xpath>
        <xpath expr="//link[@rel='shortcut icon']" position="replace">
            <link type="image/x-icon" rel="shortcut icon" href="/web/binary/company_logo"/>
        </xpath>
    </template>

    <template id="showroom_login_branding" inherit_id="web.login_layout" name="TYJ Login Branding">
        <xpath expr="//div[hasclass('card-body')]/div[1]" position="after">
            <div class="o_showroom_login_heading text-center mb-4">
                <strong>TYJ 企业管理</strong>
                <small>企业运营管理平台</small>
            </div>
        </xpath>
        <xpath expr="//div[hasclass('card-body')]/div[last()]" position="replace">
            <div class="o_showroom_login_footer text-center small mt-4 pt-3 border-top">
                TYJ 企业管理平台
            </div>
        </xpath>
    </template>
    <record id="showroom_login_branding" model="ir.ui.view">
        <field name="active" eval="False"/>
    </record>

    <template id="showroom_brand_promotion" inherit_id="web.brand_promotion" name="TYJ Brand Promotion">
        <xpath expr="//t[@t-call='web.brand_promotion_message']" position="replace">
            <t t-call="web.brand_promotion_message">
                <t t-set="_message"></t>
                <t t-set="_utm_medium" t-valuef="portal"/>
            </t>
        </xpath>
    </template>
</odoo>
