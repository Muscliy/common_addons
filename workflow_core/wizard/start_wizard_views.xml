<odoo>
    <record id="start_wizard_form" model="ir.ui.view">
        <field name="name">workflow.start.wizard.form</field>
        <field name="model">workflow.start.wizard</field>
        <field name="arch" type="xml">
            <form string="发起流程">
                <group>
                    <field name="expected_version_id" invisible="1"/>
                    <field name="definition_id" required="1" readonly="expected_version_id" options="{'no_create': True, 'no_open': True}"/>
                    <field name="business_model" invisible="1"/>
                    <field name="business_id" widget="many2one_reference" invisible="not business_model" required="business_model"
                           options="{'no_create': True, 'no_open': True}"/>
                    <field name="attachment_ids" widget="many2many_binary"/>
                </group>
                <footer>
                    <button name="action_submit" string="发起" type="object" class="btn-primary"/>
                    <button string="取消" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="open_start_wizard" model="ir.actions.server">
        <field name="name">发起流程</field>
        <field name="model_id" ref="model_workflow_start_wizard"/>
        <field name="group_ids" eval="[(4, ref('workflow_core.group_executor'))]"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open()</field>
    </record>
</odoo>
