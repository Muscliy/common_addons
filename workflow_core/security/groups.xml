<odoo>
    <record id="category_workflow" model="ir.module.category"><field name="name">工作流</field></record>
    <record id="privilege_workflow" model="res.groups.privilege">
        <field name="name">工作流</field><field name="category_id" ref="category_workflow"/>
    </record>
    <record id="group_user" model="res.groups">
        <field name="name">工作流用户</field><field name="privilege_id" ref="privilege_workflow"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_designer" model="res.groups">
        <field name="name">流程设计人员</field><field name="privilege_id" ref="privilege_workflow"/>
        <field name="implied_ids" eval="[(4, ref('group_user'))]"/>
    </record>
    <record id="group_publisher" model="res.groups">
        <field name="name">流程发布人员</field><field name="privilege_id" ref="privilege_workflow"/>
        <field name="implied_ids" eval="[(4, ref('group_user'))]"/>
    </record>
    <record id="group_executor" model="res.groups">
        <field name="name">流程执行人员</field><field name="privilege_id" ref="privilege_workflow"/>
        <field name="implied_ids" eval="[(4, ref('group_user'))]"/>
    </record>
    <record id="group_viewer" model="res.groups">
        <field name="name">流程查看人员</field><field name="privilege_id" ref="privilege_workflow"/>
        <field name="implied_ids" eval="[(4, ref('group_user'))]"/>
    </record>
    <record id="group_manager" model="res.groups">
        <field name="name">工作流管理员</field><field name="privilege_id" ref="privilege_workflow"/>
        <field name="implied_ids" eval="[(4, ref('group_designer')), (4, ref('group_publisher')), (4, ref('group_executor')), (4, ref('group_viewer'))]"/>
    </record>
    <record id="base.group_system" model="res.groups"><field name="implied_ids" eval="[(4, ref('group_manager'))]"/></record>
</odoo>
