<odoo>
    <record id="definition_kanban" model="ir.ui.view">
        <field name="name">workflow.definition.kanban</field>
        <field name="model">workflow.definition</field>
        <field name="arch" type="xml">
            <kanban records_draggable="0" quick_create="0" default_group_by="application_menu_id"
                    group_create="0" group_edit="0" group_delete="0">
                <field name="icon"/>
                <field name="application_menu_id"/>
                <field name="category_id"/>
                <field name="group_id"/>
                <field name="published_version_id"/>
                <field name="department_id"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between align-items-start gap-2">
                            <div class="d-flex align-items-center gap-2">
                                <field t-if="record.icon.raw_value" name="icon" widget="image" class="o_avatar" options="{'size': [40, 40]}"/>
                                <img t-else="" src="/workflow_core/static/description/icon.svg" width="40" height="40" alt="流程"/>
                                <field name="name" class="fw-bold fs-5 text-break"/>
                            </div>
                            <span t-if="record.published_version_id.raw_value"
                                  class="badge rounded-pill text-bg-success">已发布</span>
                            <span t-else="" class="badge rounded-pill text-bg-secondary">未发布</span>
                        </div>
                        <field name="code" class="text-muted"/>
                        <field name="group_id" class="text-muted"/>
                        <field name="category_id" class="text-muted"/>
                        <field name="manager_id" widget="many2one_avatar_user"/>
                        <field name="description" class="text-muted text-truncate"/>
                        <div class="d-flex flex-wrap gap-2 align-items-center text-muted">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="department_id" t-if="record.department_id.raw_value"/>
                            <span t-else="">全公司</span>
                        </div>
                        <field name="canvas_preview" widget="workflow_canvas_preview"/>
                        <footer>
                            <button name="action_designer" type="object" class="btn btn-outline-primary btn-sm"
                                    string="打开画布"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="definition_list" model="ir.ui.view">
        <field name="name">workflow.definition.list</field><field name="model">workflow.definition</field>
        <field name="arch" type="xml">
            <list><field name="name" string="流程名称"/><field name="application_menu_id"/><field name="group_id"/><field name="category_id"/><field name="code" string="流程编码"/><field name="model_id" groups="workflow_core.group_designer"/><field name="published_version_id" string="当前发布版本"/>
                <field name="department_id"/>
                <field name="company_id" string="所属公司" groups="base.group_multi_company"/>
                <button name="action_designer" type="object" string="打开画布" icon="fa-sitemap"/>
            </list>
        </field>
    </record>
    <record id="definition_form" model="ir.ui.view">
        <field name="name">workflow.definition.form</field><field name="model">workflow.definition</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_designer" type="object" string="打开画布" class="btn-primary"/>
                    <button name="action_new_version" type="object" string="新建版本" invisible="not can_manage"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="已归档" bg_color="text-bg-warning" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <field name="can_manage" invisible="1"/>
                    <field name="icon" widget="image" class="oe_avatar" options="{'size': [96, 96]}" readonly="not can_manage"/>
                    <group><field name="name" string="流程名称" readonly="not can_manage"/><field name="application_menu_id" options="{'no_create': True, 'no_open': True}" readonly="not can_manage"/>
                        <field name="group_id" options="{'no_create': True, 'no_open': True}" readonly="not can_manage"/>
                        <field name="category_id" domain="[('application_menu_id', '=', application_menu_id)]"
                               context="{'default_application_menu_id': application_menu_id}" invisible="not application_menu_id" readonly="not can_manage"/>
                        <field name="manager_id" widget="many2one_avatar_user" options="{'no_create': True, 'no_open': True}" readonly="not can_manage"/>
                        <field name="code" string="流程编码" required="0" placeholder="留空自动生成" readonly="not can_manage"/><field name="model_id" groups="workflow_core.group_designer" options="{'no_create': True}" readonly="not can_manage"/>
                        <field name="department_id" groups="workflow_core.group_designer" options="{'no_create': True}" placeholder="全公司" readonly="not can_manage"/>
                        <field name="starter_group_ids" widget="many2many_tags" groups="workflow_core.group_designer"
                               options="{'no_create': True}" invisible="not starter_group_ids" readonly="not can_manage"/>
                        <field name="company_id" invisible="1" groups="!base.group_multi_company"/>
                        <field name="company_id" string="所属公司" groups="base.group_multi_company" readonly="not can_manage"/><field name="published_version_id" string="当前发布版本"/>
                        <field name="version_activated_by" string="最近启用人" invisible="not version_activated_by"/>
                        <field name="version_activated_at" string="最近启用时间" invisible="not version_activated_at"/>
                    </group>
                    <group><field name="description" placeholder="流程说明" readonly="not can_manage"/></group>
                    <field name="version_ids" readonly="1">
                        <list create="0" delete="0"><field name="number" string="版本号"/><field name="state" string="状态"/><field name="published_by" string="发布人"/><field name="published_at" string="发布时间"/>
                            <field name="is_current" string="当前版本"/>
                            <button name="action_designer" type="object" string="查看版本"/>
                            <button name="action_restore" type="object" string="启用此版本" groups="workflow_core.group_publisher"
                                invisible="state != 'published' or is_current"
                                confirm="新启动的流程将使用所选版本。已启动的流程继续使用原版本。"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="definition_search" model="ir.ui.view">
        <field name="name">workflow.definition.search</field>
        <field name="model">workflow.definition</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"/>
                <field name="department_id"/>
                <field name="application_menu_id"/>
                <field name="category_id"/>
                <field name="manager_id"/>
                <field name="group_id"/>
                <group>
                    <filter name="group_application" string="所属模块" context="{'group_by': 'application_menu_id'}"/>
                    <filter name="group_custom" string="流程分组" context="{'group_by': 'group_id'}"/>
                    <filter name="group_category" string="流程类别" context="{'group_by': 'category_id'}"/>
                </group>
                <filter name="company_scope" string="全公司" domain="[('department_id', '=', False)]"/>
                <filter name="department_scope" string="部门流程" domain="[('department_id', '!=', False)]"/>
            </search>
        </field>
    </record>
    <record id="definitions" model="ir.actions.act_window">
        <field name="name">流程模板</field><field name="res_model">workflow.definition</field><field name="view_mode">kanban,list,form</field>
    </record>
</odoo>
