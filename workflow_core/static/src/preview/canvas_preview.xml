<templates xml:space="preserve">
    <t t-name="workflow_core.CanvasPreview">
        <div t-if="graph?.nodes?.length" class="position-relative">
            <CanvasPreviewDrawing graph="graph"/>
            <button type="button" class="btn btn-light btn-sm o_workflow_preview_expand"
                    title="放大预览" aria-label="放大预览" t-on-click.stop="showPreview">
                <i class="fa fa-expand" aria-hidden="true"/>
            </button>
        </div>
        <div t-else="" class="o_workflow_preview d-flex align-items-center justify-content-center text-muted small">
            暂无流程节点
        </div>
    </t>
    <t t-name="workflow_core.CanvasPreviewDrawing">
        <canvas t-ref="preview" class="o_workflow_preview o_workflow_preview_graph"
                t-att-class="{'o_workflow_preview_large': props.large}"
                role="img" aria-label="流程画布预览"/>
    </t>
    <t t-name="workflow_core.CanvasPreviewDialog">
        <Dialog title.translate="流程画布预览" size="'xl'" footer="false">
            <CanvasPreviewDrawing graph="props.graph" large="true"/>
        </Dialog>
    </t>
</templates>
