<templates xml:space="preserve">
    <t t-name="workflow_core.Action">
        <div class="o_workflow_action">
            <ControlPanel>
                <t t-set-slot="control-panel-status-indicator">
                <div class="wf-heading">
                    <span t-if="state.dirty" class="text-muted">未保存</span>
                    <span t-if="state.canvas?.instance_state" class="badge text-bg-secondary" t-esc="({running: '进行中', done: '已完成', cancelled: '已取消', rejected: '已拒绝'})[state.canvas.instance_state]"/>
                    <span t-elif="state.canvas" class="badge text-bg-secondary" t-esc="state.canvas.state === 'draft' ? '草稿' : '已发布'"/>
                </div>
                </t>
                <t t-set-slot="control-panel-navigation-additional">
                <div class="wf-actions">
                    <button t-if="state.canvas?.can_edit" class="btn btn-primary" t-on-click="saveClick" t-att-disabled="state.busy">保存</button>
                    <button t-if="state.canvas &amp;&amp; !state.canvas.instance_id" class="btn btn-secondary" t-on-click="validateClick" t-att-disabled="state.busy">校验</button>
                    <button t-if="state.canvas?.can_publish" class="btn btn-primary" t-on-click="publishClick" t-att-disabled="state.busy">发布</button>
                    <button t-if="state.canvas?.can_start" class="btn btn-primary" t-on-click="startClick" t-att-disabled="state.busy">启动流程</button>
                    <button t-if="state.canvas?.instance_id" class="btn btn-secondary" t-on-click="toggleGraph" t-att-disabled="state.busy"
                            t-esc="state.graphVisible ? '返回办理' : '查看流程图'"/>
                    <button t-if="state.canvas?.instance_id" class="btn btn-secondary" t-on-click="instanceDetails" t-att-disabled="state.busy">流程详情</button>
                    <button t-if="state.canvas?.instance_id &amp;&amp; state.canvas.business_model" class="btn btn-secondary" t-on-click="businessClick" t-att-disabled="state.busy">查看业务单据</button>
                    <button class="btn btn-secondary" t-on-click="refreshClick" t-att-disabled="state.busy" aria-label="刷新"><i class="fa fa-refresh" aria-hidden="true"/></button>
                </div>
                </t>
            </ControlPanel>
            <div t-if="state.error" class="alert alert-danger m-2" role="alert" t-esc="state.error"/>
            <div t-if="state.busy" class="wf-loading" role="status">正在处理…</div>
            <WorkflowRuntime t-if="state.canvas?.instance_id &amp;&amp; !state.graphVisible"
                             canvas="state.canvas" busy="state.busy"
                             complete.bind="complete" decide.bind="decide"
                             projectDecision.bind="projectDecision" projectOpen.bind="projectOpen"/>
            <div t-elif="!params.instance_id || state.graphVisible" class="wf-react-root" t-ref="canvas"/>
        </div>
    </t>
</templates>
